{
  "name": "dsh-codebase-memory",
  "version": "0.2.1",
  "description": "DSH bundle that bridges the Codebase Memory MCP code knowledge graph into DSH and can keep indexed repositories fresh with an optional debounced filesystem watcher.",
  "license": "MIT",
  "type": "module",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "codebase-memory",
    "mcp",
    "knowledge-graph",
    "bundle-plugin",
    "watcher",
    "chokidar"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check src/index.mjs && node --check src/state.mjs && node --check src/cli-bridge.mjs && node --check src/watcher.mjs && node --check src/routes.mjs",
    "pack:check": "npm pack --dry-run --json"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "chokidar": "^3.6.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": "^0.1.0-rc.7"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "package.json"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/andyfan1094/dsh-codebase-memory.git"
  }
}